# Non-secret optional overrides. Export them in your shell before running demo.py.
DANCEFLOW_DEMO_PROJECT=danceflow-portfolio-demo
DANCEFLOW_DEMO_DATABASE=vibe_music
DANCEFLOW_DEMO_MYSQL_PORT=3307
DANCEFLOW_DEMO_REDIS_PORT=6380
DANCEFLOW_DEMO_BACKEND_PORT=8080
# Optional: DANCEFLOW_DEMO_BACKEND_URL=http://127.0.0.1:8080
# Optional: DANCEFLOW_DEMO_JAR=/path/to/an/already-built/server.jar
# Optional: DANCEFLOW_DEMO_STATE_DIR=/path/to/private/local-state
# Optional: MAVEN_SETTINGS=/path/to/your/maven-settings.xml
# Docker respects its usual DOCKER_HOST / DOCKER_CONTEXT configuration.
